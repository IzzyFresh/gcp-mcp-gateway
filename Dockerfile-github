FROM node:20-slim
WORKDIR /app
RUN npm install -g @modelcontextprotocol/server-github
# Add a small wrapper to listen on PORT and proxy to the stdio server
# Alternatively, use a tool like 'mcp-proxy' if available, 
# but for now, let's try to run it directly if it supports an HTTP/SSE mode.
# Official server-github is stdio-only, so we need a bridge.
RUN npm install -g @modelcontextprotocol/server-bridge
ENTRYPOINT ["mcp-bridge", "npx", "-y", "@modelcontextprotocol/server-github"]
